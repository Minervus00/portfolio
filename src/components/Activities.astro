---
interface Props {
  portfolio: any;
  lang: 'en' | 'fr';
}

const { portfolio, lang } = Astro.props;
const { activites } = portfolio;

const t = lang === 'fr'
  ? {
      eyebrow: 'Rayonnement',
      heading: 'Conférences & Communauté',
      subtitle: "Interventions, ateliers et engagements dans la communauté IA.",
    }
  : {
      eyebrow: 'Community',
      heading: 'Talks & Community',
      subtitle: 'Speaking engagements, workshops, and community involvement.',
    };
---

<section id="activities" class="py-20 bg-white dark:bg-slate-800">
  <div class="container mx-auto px-4">
    <div data-aos="fade-up" class="mb-16 text-center">
      <span class="inline-block py-1 px-3 rounded-full bg-primary-100 text-primary-700 dark:bg-primary-900/30 dark:text-primary-300 text-sm font-medium mb-4">
        {t.eyebrow}
      </span>
      <h2 class="text-3xl md:text-4xl font-bold text-slate-800 dark:text-white font-heading">
        {t.heading}
      </h2>
      <p class="mt-4 max-w-2xl mx-auto text-slate-600 dark:text-slate-300">
        {t.subtitle}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-6xl mx-auto">
      {activites.map((activity: { titre: string; role: string; lieu: string; date: string; description: string }, index: number) => (
        <div
          class="bg-slate-50 dark:bg-slate-700/50 border border-slate-200 dark:border-slate-700 rounded-xl p-6 hover:shadow-lg hover:-translate-y-1 transition-all duration-300"
          data-aos="fade-up"
          data-aos-delay={(index % 3) * 100}
        >
          <h3 class="text-base font-semibold text-slate-800 dark:text-white font-heading mb-1">
            {activity.titre}
          </h3>
          <p class="text-primary-600 dark:text-primary-400 text-sm font-medium mb-3">
            {activity.role}
          </p>
          <p class="text-slate-600 dark:text-slate-300 text-sm mb-4 leading-relaxed">
            {activity.description}
          </p>
          <div class="flex items-center justify-between text-xs text-slate-500 dark:text-slate-400 pt-3 border-t border-slate-200 dark:border-slate-600">
            <span class="flex items-center">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd" />
              </svg>
              {activity.lieu}
            </span>
            <span>{activity.date}</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
